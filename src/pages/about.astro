---
const pageTitle = "About | Universal Age Calculator";
const pageDescription =
	"Learn what Universal Age Calculator is, how it works, why it was built, and the privacy-first approach behind its exact age, Hijri and zodiac features.";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<link
			rel="canonical"
			href="https://universal-age-calculator.pages.dev/about"
		/>

		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta
			property="og:url"
			content="https://universal-age-calculator.pages.dev/about"
		/>
		<meta
			property="og:image"
			content="https://universal-age-calculator.pages.dev/og-image.png"
		/>

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta
			name="twitter:image"
			content="https://universal-age-calculator.pages.dev/og-image.png"
		/>

		<meta name="theme-color" content="#6657ff" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@type": "AboutPage",
				name: "About Universal Age Calculator",
				url: "https://universal-age-calculator.pages.dev/about",
				description: pageDescription,
				isPartOf: {
					"@type": "WebSite",
					name: "Universal Age Calculator",
					url: "https://universal-age-calculator.pages.dev/",
				},
				inLanguage: "en",
			})}
		/>

		<script is:inline>
			(function () {
				const savedTheme = localStorage.getItem("age-calculator-theme");
				const prefersDark = window.matchMedia(
					"(prefers-color-scheme: dark)",
				).matches;

				if (savedTheme === "dark" || (!savedTheme && prefersDark)) {
					document.documentElement.dataset.theme = "dark";
				}
			})();
		</script>
	</head>

	<body>
		<header class="site-header">
			<div class="container header-inner">
				<a class="brand" href="/" aria-label="Universal Age Calculator home">
					<span class="brand-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24">
							<path
								d="M12 2.75a1 1 0 0 1 .93.63l1.5 3.76a4 4 0 0 0 2.24 2.24l3.76 1.5a1 1 0 0 1 0 1.86l-3.76 1.5a4 4 0 0 0-2.24 2.24l-1.5 3.76a1 1 0 0 1-1.86 0l-1.5-3.76a4 4 0 0 0-2.24-2.24l-3.76-1.5a1 1 0 0 1 0-1.86l3.76-1.5a4 4 0 0 0 2.24-2.24l1.5-3.76a1 1 0 0 1 .93-.63Z"
							></path>
						</svg>
					</span>

					<span class="brand-copy">
						<strong>Universal</strong>
						<small>Age Calculator</small>
					</span>
				</a>

				<div class="header-actions">
					<a class="header-badge header-link" href="/">Back to calculator</a>

					<button
						id="theme-toggle"
						class="theme-toggle"
						type="button"
						aria-label="Switch to dark mode"
						title="Change colour theme"
					>
						<svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true">
							<circle cx="12" cy="12" r="4"></circle>
							<path d="M12 2v2"></path>
							<path d="M12 20v2"></path>
							<path d="m4.93 4.93 1.42 1.42"></path>
							<path d="m17.66 17.66 1.41 1.41"></path>
							<path d="M2 12h2"></path>
							<path d="M20 12h2"></path>
							<path d="m6.34 17.66-1.41 1.41"></path>
							<path d="m19.07 4.93-1.41 1.41"></path>
						</svg>

						<svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true">
							<path
								d="M20.4 14.6A8.7 8.7 0 0 1 9.4 3.6 8.7 8.7 0 1 0 20.4 14.6Z"
							></path>
						</svg>
					</button>
				</div>
			</div>
		</header>

		<main>
			<section class="about-hero">
				<div class="hero-orb hero-orb-one" aria-hidden="true"></div>
				<div class="hero-orb hero-orb-two" aria-hidden="true"></div>
				<div class="hero-spark hero-spark-one" aria-hidden="true">✦</div>
				<div class="hero-spark hero-spark-two" aria-hidden="true">✦</div>

				<div class="container about-hero-inner">
					<div class="hero-copy reveal">
						<div class="hero-kicker">
							<span class="kicker-dot" aria-hidden="true"></span>
							About the project
						</div>

						<h1>More than a number on a birthday.</h1>

						<p class="hero-description">
							Universal Age Calculator turns one simple input — your birth date —
							into a useful, private and easy-to-understand picture of your age,
							calendar date, zodiac traditions and lifetime statistics.
						</p>

						<div class="hero-actions">
							<a class="primary-link" href="/">
								Open Age Calculator
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path d="M5 12h14"></path>
									<path d="m13 6 6 6-6 6"></path>
								</svg>
							</a>

							<a class="secondary-link" href="#approach">
								See our approach
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path d="M12 5v14"></path>
									<path d="m18 13-6 6-6-6"></path>
								</svg>
							</a>
						</div>

						<div class="hero-trust" aria-label="Product principles">
							<span>
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path d="m5 12 4 4L19 6"></path>
								</svg>
								Free to use
							</span>

							<span>
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path d="m5 12 4 4L19 6"></path>
								</svg>
								No sign-up
							</span>

							<span>
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path d="m5 12 4 4L19 6"></path>
								</svg>
								Private calculations
							</span>
						</div>
					</div>

					<aside class="hero-card reveal" aria-label="Project principles">
						<div class="hero-card-heading">
							<div>
								<p class="card-label">Built around three ideas</p>
								<h2>Simple on the surface. Thoughtful underneath.</h2>
							</div>

							<div class="hero-card-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24">
									<path d="M12 3v18"></path>
									<path d="M3 12h18"></path>
								</svg>
							</div>
						</div>

						<div class="hero-points">
							<div>
								<span>01</span>
								<div>
									<strong>Useful</strong>
									<p>Clear results that go beyond a basic age number.</p>
								</div>
							</div>

							<div>
								<span>02</span>
								<div>
									<strong>Private</strong>
									<p>Core calculations happen locally in your browser.</p>
								</div>
							</div>

							<div>
								<span>03</span>
								<div>
									<strong>Understandable</strong>
									<p>Traditional and estimated results include useful context.</p>
								</div>
							</div>
						</div>
					</aside>
				</div>
			</section>

			<section class="story-section section-soft">
				<div class="container split-layout">
					<div class="section-title reveal">
						<p class="eyebrow">Why it exists</p>
						<h2>A simple calculator can still feel thoughtful.</h2>
						<div class="title-accent" aria-hidden="true"></div>
					</div>

					<div class="story-copy reveal">
						<p>
							Many age calculators stop at years, months and days. Universal Age
							Calculator was created to make the experience more complete without
							making it harder to use.
						</p>
						<p>
							Alongside exact age, the tool can show your next birthday, total
							time lived, Hijri birth date, Western star sign, Chinese zodiac,
							lifetime estimates and a downloadable result card.
						</p>
						<p>
							The goal is not to turn every result into a claim of absolute
							certainty. Instead, the site distinguishes between mathematical
							calculations, calendar conversions, traditional zodiac
							interpretations and broad lifetime estimates.
						</p>
					</div>
				</div>
			</section>

			<section id="approach" class="approach-section">
				<div class="container">
					<div class="section-heading reveal">
						<p class="eyebrow">Our approach</p>
						<h2>How the calculator is designed.</h2>
						<p>
							The site is built around practical accuracy, respectful presentation
							and a lightweight browser-first experience.
						</p>
					</div>

					<div class="approach-grid">
						<article class="approach-card accent-calendar reveal">
							<div class="approach-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24">
									<rect x="3" y="5" width="18" height="16" rx="2"></rect>
									<path d="M16 3v4"></path>
									<path d="M8 3v4"></path>
									<path d="M3 11h18"></path>
								</svg>
							</div>

							<div class="approach-content">
								<p class="card-label">Exact age</p>
								<h3>Calendar-aware calculations</h3>
								<p>
									Completed years, months and days are calculated from the
									selected birth date and current local date, accounting for real
									month lengths and leap years.
								</p>
							</div>
						</article>

						<article class="approach-card accent-tradition reveal">
							<div class="approach-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24">
									<path
										d="M20.4 14.6A8.7 8.7 0 0 1 9.4 3.6 8.7 8.7 0 1 0 20.4 14.6Z"
									></path>
								</svg>
							</div>

							<div class="approach-content">
								<p class="card-label">Birth traditions</p>
								<h3>Context, not overstatement</h3>
								<p>
									Hijri dates and zodiac systems are presented as calendar or
									traditional information, with explanations where methods and
									interpretations can vary.
								</p>
							</div>
						</article>

						<article class="approach-card accent-privacy reveal">
							<div class="approach-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24">
									<rect x="5" y="10" width="14" height="11" rx="2"></rect>
									<path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
								</svg>
							</div>

							<div class="approach-content">
								<p class="card-label">Privacy</p>
								<h3>Browser-first by default</h3>
								<p>
									The core age calculation does not require an account or a
									server-side birth-date history. Your selected date is used in
									the browser to produce results.
								</p>
							</div>
						</article>

						<article class="approach-card accent-accessibility reveal">
							<div class="approach-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24">
									<circle cx="12" cy="12" r="9"></circle>
									<path d="M12 7v10"></path>
									<path d="M7 12h10"></path>
								</svg>
							</div>

							<div class="approach-content">
								<p class="card-label">Accessibility</p>
								<h3>Designed to work across devices</h3>
								<p>
									The interface is responsive, supports light and dark themes,
									and uses familiar controls so the calculator remains
									straightforward on phones, tablets and desktop browsers.
								</p>
							</div>
						</article>
					</div>
				</div>
			</section>

			<section class="features-section section-soft">
				<div class="container">
					<div class="section-heading reveal">
						<p class="eyebrow">What you can explore</p>
						<h2>One birth date, several useful perspectives.</h2>
						<p>
							Each result has a clear purpose — from exact elapsed time to calendar
							traditions and downloadable summaries.
						</p>
					</div>

					<div class="feature-list reveal">
						<div class="feature-item">
							<div class="feature-icon" aria-hidden="true">01</div>
							<div>
								<span>Exact age</span>
								<strong>Years, months and days</strong>
							</div>
						</div>

						<div class="feature-item">
							<div class="feature-icon" aria-hidden="true">02</div>
							<div>
								<span>Time lived</span>
								<strong>Months, weeks, days, hours, minutes and seconds</strong>
							</div>
						</div>

						<div class="feature-item">
							<div class="feature-icon" aria-hidden="true">03</div>
							<div>
								<span>Birthday</span>
								<strong>Next birthday date and countdown</strong>
							</div>
						</div>

						<div class="feature-item">
							<div class="feature-icon" aria-hidden="true">04</div>
							<div>
								<span>Islamic calendar</span>
								<strong>Hijri birth date and current Hijri date</strong>
							</div>
						</div>

						<div class="feature-item">
							<div class="feature-icon" aria-hidden="true">05</div>
							<div>
								<span>Western zodiac</span>
								<strong>Star sign, date range and traditional traits</strong>
							</div>
						</div>

						<div class="feature-item">
							<div class="feature-icon" aria-hidden="true">06</div>
							<div>
								<span>Chinese zodiac</span>
								<strong>Animal, element and traditional traits</strong>
							</div>
						</div>

						<div class="feature-item">
							<div class="feature-icon" aria-hidden="true">07</div>
							<div>
								<span>Lifetime journey</span>
								<strong>General heartbeat, breathing and sleep estimates</strong>
							</div>
						</div>

						<div class="feature-item">
							<div class="feature-icon" aria-hidden="true">08</div>
							<div>
								<span>Shareable result</span>
								<strong>Downloadable age card and copyable summary</strong>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section class="transparency-section">
				<div class="container transparency-card reveal">
					<div class="transparency-heading">
						<div>
							<p class="eyebrow">Transparency matters</p>
							<h2>Not every result means the same thing.</h2>
						</div>

						<p class="transparency-intro">
							We separate calculations, calendar conversions, traditional
							interpretations and broad estimates so the context stays clear.
						</p>
					</div>

					<div class="transparency-grid">
						<div class="transparency-item">
							<span class="status status-calculated">Calculated</span>
							<div class="status-icon status-icon-calculated" aria-hidden="true">
								<svg viewBox="0 0 24 24">
									<path d="m5 12 4 4L19 6"></path>
								</svg>
							</div>
							<h3>Age and elapsed time</h3>
							<p>
								These are mathematical results derived from the date you enter
								and the current date or time.
							</p>
						</div>

						<div class="transparency-item">
							<span class="status status-calendar">Calendar</span>
							<div class="status-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24">
									<path
										d="M20.4 14.6A8.7 8.7 0 0 1 9.4 3.6 8.7 8.7 0 1 0 20.4 14.6Z"
									></path>
								</svg>
							</div>
							<h3>Hijri date</h3>
							<p>
								This is a browser-supported calendar conversion and can differ
								from locally observed or officially adopted dates.
							</p>
						</div>

						<div class="transparency-item">
							<span class="status status-traditional">Traditional</span>
							<div class="status-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24">
									<path d="M12 3 14.6 8.4 20.5 9.2 16.2 13.3 17.3 19.2 12 16.4 6.7 19.2 7.8 13.3 3.5 9.2 9.4 8.4Z"></path>
								</svg>
							</div>
							<h3>Zodiac descriptions</h3>
							<p>
								These are cultural and entertainment-oriented associations, not
								scientific personality assessments.
							</p>
						</div>

						<div class="transparency-item">
							<span class="status status-estimate">Estimate</span>
							<div class="status-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24">
									<path d="M4 18V10"></path>
									<path d="M10 18V6"></path>
									<path d="M16 18V13"></path>
									<path d="M22 18V3"></path>
								</svg>
							</div>
							<h3>Heartbeats, breaths and sleep</h3>
							<p>
								These use broad averages for interest and illustration and are
								not measurements of your health.
							</p>
						</div>
					</div>
				</div>
			</section>

			<section class="evolution-section section-soft">
				<div class="container split-layout">
					<div class="section-title reveal">
						<p class="eyebrow">Built to improve</p>
						<h2>The site is meant to grow carefully.</h2>
						<div class="title-accent" aria-hidden="true"></div>
					</div>

					<div class="story-copy reveal">
						<p>
							Universal Age Calculator is an evolving project. New features,
							educational content and related calculators may be added as the site
							develops.
						</p>
						<p>
							Changes are approached with the same priorities as the current
							version: useful results, clear limitations, strong privacy defaults
							and a clean user experience.
						</p>
						<p>
							When functionality changes in a way that affects privacy or the
							conditions of use, the site's Privacy Policy and Terms of Use are
							updated alongside the product.
						</p>
					</div>
				</div>
			</section>

			<section class="cta-section">
				<div class="container cta-card reveal">
					<div class="cta-glow" aria-hidden="true"></div>

					<div class="cta-copy">
						<p class="eyebrow">Ready to explore?</p>
						<h2>See your life in numbers.</h2>
						<p>
							Calculate your exact age, discover your Hijri birth date and zodiac
							traditions, and create a shareable result card.
						</p>

						<div class="cta-trust">
							<span>
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path d="m5 12 4 4L19 6"></path>
								</svg>
								No sign-up required
							</span>
							<span>
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path d="m5 12 4 4L19 6"></path>
								</svg>
								Your birth date stays in your browser
							</span>
						</div>
					</div>

					<a href="/">
						Calculate My Age
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M5 12h14"></path>
							<path d="m13 6 6 6-6 6"></path>
						</svg>
					</a>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-glow footer-glow-one" aria-hidden="true"></div>
			<div class="footer-glow footer-glow-two" aria-hidden="true"></div>

			<div class="container footer-shell">
				<div class="footer-main">
					<div class="footer-brand-column">
						<a class="footer-brand" href="/" aria-label="Universal Age Calculator">
							<span class="footer-brand-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24">
									<path
										d="M12 2.75a1 1 0 0 1 .93.63l1.5 3.76a4 4 0 0 0 2.24 2.24l3.76 1.5a1 1 0 0 1 0 1.86l-3.76 1.5a4 4 0 0 0-2.24 2.24l-1.5 3.76a1 1 0 0 1-1.86 0l-1.5-3.76a4 4 0 0 0-2.24-2.24l-3.76-1.5a1 1 0 0 1 0-1.86l3.76-1.5a4 4 0 0 0 2.24-2.24l1.5-3.76a1 1 0 0 1 .93-.63Z"
									></path>
								</svg>
							</span>

							<span class="footer-brand-copy">
								<strong>Universal</strong>
								<small>Age Calculator</small>
							</span>
						</a>

						<p class="footer-description">
							Calculate your exact age, explore your birth date across traditions,
							and discover the story behind the numbers — privately in your browser.
						</p>

						<div class="footer-trust" aria-label="Tool benefits">
							<span>
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path d="m5 12 4 4L19 6"></path>
								</svg>
								Free to use
							</span>

							<span>
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path d="m5 12 4 4L19 6"></path>
								</svg>
								No sign-up
							</span>

							<span>
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path d="m5 12 4 4L19 6"></path>
								</svg>
								Private calculations
							</span>
						</div>
					</div>

					<nav class="footer-navigation" aria-label="Footer navigation">
						<p class="footer-heading">Explore</p>

						<a href="/#calculator">
							<span>Age calculator</span>
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path d="M5 12h14"></path>
								<path d="m13 6 6 6-6 6"></path>
							</svg>
						</a>

						<a href="/#birth-traditions">
							<span>Birth traditions</span>
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path d="M5 12h14"></path>
								<path d="m13 6 6 6-6 6"></path>
							</svg>
						</a>

						<a href="/#lifetime-statistics">
							<span>Lifetime statistics</span>
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path d="M5 12h14"></path>
								<path d="m13 6 6 6-6 6"></path>
							</svg>
						</a>

						<a href="/#age-guide">
							<span>Age calculation guide</span>
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path d="M5 12h14"></path>
								<path d="m13 6 6 6-6 6"></path>
							</svg>
						</a>

						<a href="/#faq">
							<span>Frequently asked questions</span>
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path d="M5 12h14"></path>
								<path d="m13 6 6 6-6 6"></path>
							</svg>
						</a>
					</nav>

					<div class="footer-privacy-column">
						<p class="footer-heading">Privacy by design</p>

						<div class="footer-privacy-card">
							<div class="footer-privacy-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24">
									<rect x="5" y="10" width="14" height="11" rx="2"></rect>
									<path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
