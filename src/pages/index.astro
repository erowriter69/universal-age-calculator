				context.fillText(
					`${results.exactAge.months} months and ${results.exactAge.days} days`,
					600,
					650,
				);

				context.fillStyle = "rgba(255, 255, 255, 0.84)";
				context.font =
					"500 34px Arial, Helvetica, sans-serif";

				context.fillText(
					`Born ${formatFullDate(results.birthDate)}`,
					600,
					750,
				);

				context.fillText(
					`Next birthday in ${results.nextBirthday.daysUntil} days`,
					600,
					815,
				);

				const showHijriOnCard = muslimFriendly;
				const cardPanelHeight = showHijriOnCard ? 210 : 150;

				context.fillStyle = "rgba(255, 255, 255, 0.14)";
				roundRect(context, 150, 865, 900, cardPanelHeight, 28);
				context.fill();

				const westernLine = `${results.westernZodiac.symbol} ${results.westernZodiac.name}`;
				const chineseLine = chineseDisplay.hideAnimal
					? `${results.zodiac.element} element`
					: `${chineseDisplay.element.replace(" element", "")} ${chineseDisplay.title}`;

				if (showHijriOnCard) {
					context.fillStyle = "#ffffff";
					context.font =
						"700 31px Arial, Helvetica, sans-serif";
					context.fillText(
						`Hijri birth date: ${results.hijriBirthDate}`,
						600,
						915,
					);

					context.fillStyle = "#ffffff";
					context.font =
						"700 31px Arial, Helvetica, sans-serif";
					context.fillText(
						`${westernLine} · ${chineseLine}`,
						600,
						960,
					);

					context.fillStyle = "rgba(255, 255, 255, 0.86)";
					context.font =
						"500 24px Arial, Helvetica, sans-serif";
					context.fillText(
						chineseDisplay.description,
						600,
						1005,
					);
				} else {
					context.fillStyle = "#ffffff";
					context.font =
						"700 31px Arial, Helvetica, sans-serif";
					context.fillText(
						`${westernLine} · ${chineseLine}`,
						600,
						950,
					);
				}

				context.fillStyle = "rgba(255, 255, 255, 0.65)";
				context.font =
					"500 24px Arial, Helvetica, sans-serif";

				context.fillText(
					"Created with Universal Age Calculator",
					600,
					1135,
				);

				const downloadLink = document.createElement("a");

				downloadLink.download = "my-age-card.png";
				downloadLink.href = canvas.toDataURL("image/png");
				downloadLink.click();
			}

			function roundRect(
				context,
				x,
				y,
				width,
				height,
				radius,
			) {
				context.beginPath();
				context.roundRect(x, y, width, height, radius);
			}

			function formatFullDate(date) {
				return date.toLocaleDateString("en-US", {
					day: "numeric",
					month: "long",
					year: "numeric",
				});
			}

			function formatNumber(value) {
				return new Intl.NumberFormat("en-US").format(value);
			}

			function formatCompactNumber(value) {
				return new Intl.NumberFormat("en-US", {
					notation: "compact",
					maximumFractionDigits: 2,
				}).format(value);
			}

			function setText(selector, value) {
				const element = document.querySelector(selector);

				if (element) {
					element.textContent = value;
				}
			}
		</script>
