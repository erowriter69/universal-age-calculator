---
const pageTitle =
	"Universal Age Calculator – Exact Age, Hijri Date & Zodiac Signs";

const pageDescription =
	"Calculate your exact age in years, months and days. Discover your Hijri birth date, Western star sign, Chinese zodiac, next birthday and lifetime statistics.";
---

<!doctype html>
<html lang="en">
	<script
	type="application/ld+json"
	set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "WebApplication",
		name: "Universal Age Calculator",
		url: "https://universal-age-calculator.pages.dev/",
		description: pageDescription,
		applicationCategory: "UtilitiesApplication",
		operatingSystem: "Any",
		browserRequirements: "Requires JavaScript",
		offers: {
			"@type": "Offer",
			price: "0",
			priceCurrency: "USD",
		},
		featureList: [
			"Exact age calculation",
			"Birthday countdown",
			"Hijri calendar conversion",
			"Western zodiac sign calculation",
			"Chinese zodiac calculation",
			"Lifetime statistics",
			"Downloadable age card",
		],
	})}
/>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />

		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		
		<link rel="canonical" href="https://universal-age-calculator.pages.dev/" />

<meta property="og:url" content="https://universal-age-calculator.pages.dev/" />
<meta property="og:image" content="https://universal-age-calculator.pages.dev/og-image.png" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="twitter:image" content="https://universal-age-calculator.pages.dev/og-image.png" />

		<meta name="theme-color" content="#6657ff" />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<script is:inline>
			(function () {
				const savedTheme = localStorage.getItem("age-calculator-theme");
				const prefersDark = window.matchMedia(
					"(prefers-color-scheme: dark)",
				).matches;

				if (savedTheme === "dark" || (!savedTheme && prefersDark)) {
					document.documentElement.dataset.theme = "dark";
				}
			})();
		</script>
	</head>

	<body>
		<header class="site-header">
			<div class="container header-inner">
				<a class="brand" href="/" aria-label="Universal Age Calculator home">
					<span class="brand-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24">
							<path
								d="M12 2.75a1 1 0 0 1 .93.63l1.5 3.76a4 4 0 0 0 2.24 2.24l3.76 1.5a1 1 0 0 1 0 1.86l-3.76 1.5a4 4 0 0 0-2.24 2.24l-1.5 3.76a1 1 0 0 1-1.86 0l-1.5-3.76a4 4 0 0 0-2.24-2.24l-3.76-1.5a1 1 0 0 1 0-1.86l3.76-1.5a4 4 0 0 0 2.24-2.24l1.5-3.76a1 1 0 0 1 .93-.63Z"
							></path>
						</svg>
					</span>

					<span class="brand-copy">
						<strong>Universal</strong>
						<small>Age Calculator</small>
					</span>
				</a>

				<div class="header-actions">
					<span class="header-badge">Free online tool</span>

					<button
						id="theme-toggle"
						class="theme-toggle"
						type="button"
						aria-label="Switch to dark mode"
						title="Change colour theme"
					>
						<svg
							class="sun-icon"
							viewBox="0 0 24 24"
							aria-hidden="true"
						>
							<circle cx="12" cy="12" r="4"></circle>
							<path d="M12 2v2"></path>
							<path d="M12 20v2"></path>
							<path d="m4.93 4.93 1.42 1.42"></path>
							<path d="m17.66 17.66 1.41 1.41"></path>
							<path d="M2 12h2"></path>
							<path d="M20 12h2"></path>
							<path d="m6.34 17.66-1.41 1.41"></path>
							<path d="m19.07 4.93-1.41 1.41"></path>
						</svg>

						<svg
							class="moon-icon"
							viewBox="0 0 24 24"
							aria-hidden="true"
						>
							<path
								d="M20.4 14.6A8.7 8.7 0 0 1 9.4 3.6 8.7 8.7 0 1 0 20.4 14.6Z"
							></path>
						</svg>
					</button>
				</div>
			</div>
		</header>

		<main>
			<section class="hero">
				<div class="container hero-inner">
					<div class="hero-copy">
						<p class="eyebrow">More than a birthday calculator</p>

						<h1>Calculate your exact age instantly.</h1>

						<p class="hero-description">
							Find your age in years, months, weeks, days, hours and
							seconds. Discover your next birthday, Hijri birth date,
							Western star sign, Chinese zodiac and fascinating lifetime statistics.
						</p>

						<div class="feature-row" aria-label="Calculator features">
							<span>
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path d="m5 12 4 4L19 6"></path>
								</svg>
								Exact age
							</span>

							<span>
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path d="m5 12 4 4L19 6"></path>
								</svg>
								Birth traditions
							</span>

							<span>
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path d="m5 12 4 4L19 6"></path>
								</svg>
								Lifetime statistics
							</span>
						</div>
					</div>

					<div class="calculator-card">
						<div class="calculator-heading">
							<div>
								<p class="card-label">Start here</p>
								<h2>Enter your birth date</h2>
							</div>

							<div class="card-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24">
									<rect x="3" y="5" width="18" height="16" rx="2"></rect>
									<path d="M16 3v4"></path>
									<path d="M8 3v4"></path>
									<path d="M3 11h18"></path>
								</svg>
							</div>
						</div>

						<form id="age-form" novalidate>
							<label for="birth-date">Date of birth</label>

							<input
								id="birth-date"
								name="birthDate"
								type="date"
								required
								autocomplete="bday"
							/>

							<label class="preference-option" for="hide-pig-reference">
								<input
									id="hide-pig-reference"
									name="hidePigReference"
									type="checkbox"
								/>

								<span class="preference-control" aria-hidden="true">
									<svg viewBox="0 0 24 24">
										<path d="m5 12 4 4L19 6"></path>
									</svg>
								</span>

								<span class="preference-copy">
									<strong>Are you Muslim?</strong>
									<small>
										We'll present Chinese zodiac results in a culturally
										appropriate way.
									</small>
								</span>

								<span class="preference-glow" aria-hidden="true"></span>
							</label>

							<p id="form-error" class="form-error" role="alert"></p>

							<button type="submit">
								<span>Calculate my age</span>

								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path d="M5 12h14"></path>
									<path d="m13 6 6 6-6 6"></path>
								</svg>
							</button>
						</form>

						<p class="privacy-note">
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<rect x="5" y="10" width="14" height="11" rx="2"></rect>
								<path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
							</svg>

							Your birth date stays in your browser and is never uploaded.
						</p>
					</div>
				</div>
			</section>

			<section id="results-section" class="results-section" hidden>
				<div class="container">
					<div class="section-heading">
						<p class="eyebrow">Your personalised results</p>
						<h2>Your life in numbers</h2>

						<p id="result-introduction">
							Here is your age calculated from your selected birth date.
						</p>
					</div>

					<div class="age-highlight">
						<div class="age-unit">
							<strong id="age-years" data-animate="0">0</strong>
							<span>Years</span>
						</div>

						<div class="age-divider" aria-hidden="true"></div>

						<div class="age-unit">
							<strong id="age-months" data-animate="0">0</strong>
							<span>Months</span>
						</div>

						<div class="age-divider" aria-hidden="true"></div>

						<div class="age-unit">
							<strong id="age-days" data-animate="0">0</strong>
							<span>Days</span>
						</div>
					</div>

					<div class="result-grid">
						<article class="result-card">
							<div class="result-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24">
									<path d="M4 10h16v10H4z"></path>
									<path d="M12 4v6"></path>
									<path d="M8 7h8"></path>
									<path d="M4 14h16"></path>
									<path d="M7 10V8"></path>
									<path d="M17 10V8"></path>
								</svg>
							</div>

							<p>Next birthday</p>
							<strong id="next-birthday">—</strong>
							<span id="next-birthday-date">—</span>
						</article>

						<article class="result-card">
							<div class="result-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24">
									<rect x="3" y="5" width="18" height="16" rx="2"></rect>
									<path d="M16 3v4"></path>
									<path d="M8 3v4"></path>
									<path d="M3 11h18"></path>
									<path d="M8 15h.01"></path>
									<path d="M12 15h.01"></path>
									<path d="M16 15h.01"></path>
								</svg>
							</div>

							<p>Born on</p>
							<strong id="birth-weekday">—</strong>
							<span id="formatted-birth-date">—</span>
						</article>

						<article class="result-card">
							<div class="result-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24">
									<circle cx="12" cy="12" r="9"></circle>
									<path d="M3 12h18"></path>
									<path d="M12 3a15 15 0 0 1 0 18"></path>
									<path d="M12 3a15 15 0 0 0 0 18"></path>
								</svg>
							</div>

							<p>Earth journeys</p>
							<strong id="earth-orbits">—</strong>
							<span>Completed journeys around the Sun</span>
						</article>

						<article class="result-card">
							<div class="result-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24">
									<path
										d="M20.4 14.6A8.7 8.7 0 0 1 9.4 3.6 8.7 8.7 0 1 0 20.4 14.6Z"
									></path>
								</svg>
							</div>

							<p>Moon cycles</p>
							<strong id="moon-cycles">—</strong>
							<span>Approximately completed</span>
						</article>
					</div>

					<section class="world-calendar-panel">
						<div class="panel-heading">
							<div>
								<p class="card-label">Birth traditions</p>
								<h3>Your birth date across traditions</h3>
							</div>

							<p>
								Explore your Hijri birth date and your Western and Chinese zodiac signs.
							</p>
						</div>

						<div class="calendar-grid">
							<article class="calendar-card hijri-card">
								<div class="calendar-card-top">
									<div class="calendar-symbol" aria-hidden="true">
										<svg viewBox="0 0 24 24">
											<path
												d="M20.4 14.6A8.7 8.7 0 0 1 9.4 3.6 8.7 8.7 0 1 0 20.4 14.6Z"
											></path>
											<path d="m17.5 3.5.5 1.2 1.2.5-1.2.5-.5 1.2-.5-1.2-1.2-.5 1.2-.5Z"></path>
										</svg>
									</div>

									<span>Islamic calendar</span>
								</div>

								<p class="calendar-name">Hijri birth date</p>

<div class="calendar-date-display">
	<strong id="hijri-day">—</strong>

	<div>
		<span id="hijri-month">—</span>
		<b id="hijri-year">—</b>
	</div>
</div>

<p id="hijri-birth-date" class="accessible-calendar-date">—</p>

								<div class="calendar-detail">
									<span>Current Hijri date</span>
									<b id="hijri-current-date">—</b>
								</div>
							</article>

							<article class="calendar-card western-card">
								<div class="calendar-card-top">
									<div class="calendar-symbol western-symbol" aria-hidden="true">
										<span id="western-zodiac-symbol">✦</span>
									</div>

									<span>Western zodiac</span>
								</div>

								<p class="calendar-name">Your star sign</p>

								<div class="zodiac-result western-zodiac-result">
									<strong id="western-zodiac-sign">—</strong>
									<span id="western-zodiac-range">—</span>
								</div>

								<p id="western-zodiac-description" class="zodiac-description">
									—
								</p>
							</article>

							<article class="calendar-card zodiac-card">
								<div class="calendar-card-top">
									<div class="calendar-symbol" aria-hidden="true">
										<svg viewBox="0 0 24 24">
											<path
												d="M8 7c1.6-3 6.4-3 8 0 2.8.4 4 3.8 2 5.8 1.8 2.9-.9 6.4-4.2 5.5A4 4 0 0 1 6.2 18C3 18.5 1.4 14.7 4 12.7 2.2 9.8 4.9 6.5 8 7Z"
											></path>
											<path d="M9 10h.01"></path>
											<path d="M15 10h.01"></path>
											<path d="M9.5 14c1.5 1 3.5 1 5 0"></path>
										</svg>
									</div>

									<span>Chinese zodiac</span>
								</div>

								<p id="chinese-zodiac-label" class="calendar-name">Your zodiac sign</p>

								<div class="zodiac-result">
									<strong id="zodiac-animal">—</strong>
									<span id="zodiac-element">—</span>
								</div>

								<p id="zodiac-description" class="zodiac-description">
									—
								</p>
							</article>
						</div>
					</section>

					<section class="statistics-panel">
						<div class="statistics-heading">
							<div>
								<p class="card-label">Lifetime statistics</p>
								<h3>How long have you lived?</h3>
							</div>

							<span class="live-indicator">
								<span aria-hidden="true"></span>
								Live
							</span>
						</div>

						<div class="statistics-grid">
							<div class="statistic">
								<span>Total months</span>
								<strong id="total-months">0</strong>
							</div>

							<div class="statistic">
								<span>Total weeks</span>
								<strong id="total-weeks">0</strong>
							</div>

							<div class="statistic">
								<span>Total days</span>
								<strong id="total-days">0</strong>
							</div>

							<div class="statistic">
								<span>Total hours</span>
								<strong id="total-hours">0</strong>
							</div>

							<div class="statistic">
								<span>Total minutes</span>
								<strong id="total-minutes">0</strong>
							</div>

							<div class="statistic">
								<span>Total seconds</span>
								<strong id="total-seconds">0</strong>
							</div>
						</div>
					</section>

					<section class="fun-statistics-panel">
						<div class="panel-heading">
							<div>
								<p class="card-label">Fun estimates</p>
								<h3>Your lifetime journey</h3>
							</div>

							<p>
								These values are interesting general estimates, not
								medical measurements.
							</p>
						</div>

						<div class="fun-grid">
							<article class="fun-card">
								<div class="fun-icon heartbeat-icon" aria-hidden="true">
									<svg viewBox="0 0 24 24">
										<path
											d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"
										></path>
										<path d="M3.5 12h4l1.5-3 3 7 2-4h6.5"></path>
									</svg>
								</div>

								<div>
									<span>Estimated heartbeats</span>
									<strong id="estimated-heartbeats">0</strong>
								</div>
							</article>

							<article class="fun-card">
								<div class="fun-icon breath-icon" aria-hidden="true">
									<svg viewBox="0 0 24 24">
										<path d="M12 5v14"></path>
										<path d="M12 12c-2-4-7-5-8 0s4 7 8 3"></path>
										<path d="M12 12c2-4 7-5 8 0s-4 7-8 3"></path>
									</svg>
								</div>

								<div>
									<span>Estimated breaths</span>
									<strong id="estimated-breaths">0</strong>
								</div>
							</article>

							<article class="fun-card">
								<div class="fun-icon sleep-icon" aria-hidden="true">
									<svg viewBox="0 0 24 24">
										<path
											d="M20.4 14.6A8.7 8.7 0 0 1 9.4 3.6 8.7 8.7 0 1 0 20.4 14.6Z"
										></path>
										<path d="M15 5h4l-4 4h4"></path>
									</svg>
								</div>

								<div>
									<span>Estimated hours asleep</span>
									<strong id="estimated-sleep">0</strong>
								</div>
							</article>

							<article class="fun-card">
								<div class="fun-icon birthday-icon" aria-hidden="true">
									<svg viewBox="0 0 24 24">
										<path d="M4 10h16v10H4z"></path>
										<path d="M4 14h16"></path>
										<path d="M12 4v6"></path>
										<path d="M9 6c0-1 1-2 3-3 2 1 3 2 3 3"></path>
									</svg>
								</div>

								<div>
									<span>Birthdays completed</span>
									<strong id="birthdays-completed">0</strong>
								</div>
							</article>
						</div>
					</section>

					<section class="milestones-panel">
						<div class="panel-heading">
							<div>
								<p class="card-label">During your lifetime</p>
								<h3>Technology milestones</h3>
							</div>

							<p>
								A selection of widely known developments that happened
								after your birth.
							</p>
						</div>

						<div id="timeline-list" class="timeline-list"></div>
					</section>

					<div class="result-actions">
						<button id="download-card" class="primary-action" type="button">
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path d="M12 3v12"></path>
								<path d="m7 10 5 5 5-5"></path>
								<path d="M5 21h14"></path>
							</svg>

							Download age card
						</button>

						<button id="copy-results" class="secondary-action" type="button">
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<rect x="9" y="9" width="11" height="11" rx="2"></rect>
								<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
							</svg>

							<span id="copy-button-text">Copy results</span>
						</button>

						<button id="calculate-again" class="secondary-action" type="button">
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path d="M3 12a9 9 0 1 0 3-6.7"></path>
								<path d="M3 3v6h6"></path>
							</svg>

							Calculate again
						</button>
					</div>
				</div>
			</section>

			<section class="information-section">
				<div class="container information-grid">
					<div>
						<p class="eyebrow">Simple, private and precise</p>
						<h2>What does this age calculator show?</h2>
					</div>

					<div class="information-copy">
						<p>
							The calculator compares your selected birth date with the
							current date and displays your completed years, remaining
							months and days.
						</p>

						<p>
							It also converts your birth date into the Islamic Hijri calendar,
							identifies your Western star sign and Chinese zodiac, and
							calculates how many weeks, days, hours, minutes and seconds
							you have lived.
						</p>

						<p>
							Everything is calculated inside your browser. Your date is
							not uploaded to a server or stored in an online account.
						</p>
					</div>
				</div>
			</section>

			<section class="faq-section">
				<div class="container">
					<div class="section-heading faq-heading">
						<p class="eyebrow">Frequently asked questions</p>
						<h2>Age calculator questions</h2>
					</div>

					<div class="faq-list">
						<details>
							<summary>How is my exact age calculated?</summary>
							<p>
								Your exact age is calculated by comparing your birth year,
								month and day with the current local date on your device.
							</p>
						</details>

						<details>
							<summary>Is my birth date saved?</summary>
							<p>
								No. The calculation happens locally in your browser and
								your selected birth date is not uploaded by this website.
							</p>
						</details>

						<details>
							<summary>Are the heartbeat and sleep totals exact?</summary>
							<p>
								No. These are general estimates designed for entertainment.
								Real values vary between individuals and throughout life.
							</p>
						</details>

						<details>
							<summary>Why can calendar dates vary between sources?</summary>
							<p>
								Calendar conversions can vary slightly depending on the
								regional method, observation rules and calendar system used.
							</p>
						</details>
					</div>
				</div>
			</section>
		</main>

		<footer>
			<div class="container footer-inner">
				<p>
					© <span id="current-year"></span> Universal Age Calculator
				</p>

				<p>Built as a fast and private browser-based tool.</p>
			</div>
		</footer>

		<script>
			const form = document.querySelector("#age-form");
			const birthDateInput = document.querySelector("#birth-date");
			const hidePigReferenceInput = document.querySelector("#hide-pig-reference");
			const formError = document.querySelector("#form-error");
			const resultsSection = document.querySelector("#results-section");

			const themeToggle = document.querySelector("#theme-toggle");
			const downloadButton = document.querySelector("#download-card");
			const copyButton = document.querySelector("#copy-results");
