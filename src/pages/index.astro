			function getChineseZodiac(date) {
				const zodiacYear = getChineseCalendarYear(date);
				const animalIndex = positiveModulo(zodiacYear - 4, 12);

				const stemIndex = positiveModulo(zodiacYear - 4, 10);

				const elements = [
