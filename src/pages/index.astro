				const totalWeeks = Math.floor(totalDays / 7);
				const totalMonths = Math.floor(totalDays / 30.436875);

				const exactAge = calculateExactAge(birthDate, currentDate);

				const estimatedHeartbeats = totalMinutes * 72;
				const estimatedBreaths = totalMinutes * 16;
				const estimatedSleepHours = Math.floor(totalHours / 3);

				setText("#total-months", formatNumber(totalMonths));
