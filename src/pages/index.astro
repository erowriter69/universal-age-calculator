---
const pageTitle =
	"Universal Age Calculator – Exact Age, Hijri Date & Zodiac Signs";

const pageDescription =
	"Calculate your exact age in years, months and days. Discover your Hijri birth date, Western star sign, Chinese zodiac, next birthday and lifetime statistics.";

const faqItems = [
	{
		question: "How is my exact age calculated?",
		answer:
			"Your exact age is calculated by comparing your birth year, month and day with the current local date on your device. The calculator counts completed calendar years first, then completed months, then the remaining days.",
	},
	{
		question: "Does this age calculator account for leap years?",
		answer:
			"Yes. Leap years are handled when calculating your exact age and your next birthday. The Gregorian calendar normally adds February 29 every four years, except for century years that are not divisible by 400.",
	},
	{
		question: "What happens if I was born on February 29?",
		answer:
			"For leap-day birthdays, the calculator keeps February 29 as your birth date. In a non-leap year, the next-birthday display uses February 28 so the countdown remains practical and consistent.",
	},
	{
		question: "Why can my Hijri birth date differ from another converter?",
		answer:
			"Hijri dates can vary by a day between sources because Islamic calendars may use different calculation methods, regional conventions or moon-sighting practices. This calculator uses the Islamic calendar support available in your browser.",
	},
	{
		question: "How is my Western zodiac sign determined?",
		answer:
			"Your Western zodiac sign is determined from the month and day of your Gregorian birth date using the commonly used twelve-sign date ranges, from Aries through Pisces.",
	},
	{
		question: "How is my Chinese zodiac calculated?",
		answer:
			"The Chinese zodiac follows the Chinese calendar rather than changing on January 1. The calculator reads the Chinese calendar year for your birth date, then determines the traditional animal and five-element cycle for that year.",
	},
	{
		question: "Is my birth date saved or uploaded?",
		answer:
			"No. Your selected birth date is processed locally in your browser for the calculations on this page. The calculator does not need to upload the date to a server to produce your results.",
	},
	{
		question: "Are the heartbeat, breathing and sleep totals exact?",
		answer:
			"No. Those values are clearly labelled estimates. They use general rates to turn your time lived into interesting lifetime statistics, so they should not be treated as medical measurements.",
	},
	{
		question: "Can I use the calculator for someone else's birthday?",
		answer:
			"Yes. You can enter any valid birth date that is not in the future. This makes the calculator useful for checking the age of a family member, friend or historical date as well as your own.",
	},
	{
		question: "Why can total months differ from my calendar age in months?",
		answer:
			"The exact age at the top uses calendar years, months and days. The separate lifetime total for months is an approximate conversion based on the average length of a Gregorian month, so it answers a different question.",
	},
];
---

<!doctype html>
<html lang="en">
	<script
	type="application/ld+json"
	set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "WebApplication",
		name: "Universal Age Calculator",
		url: "https://universal-age-calculator.pages.dev/",
		description: pageDescription,
		applicationCategory: "UtilitiesApplication",
		operatingSystem: "Any",
		browserRequirements: "Requires JavaScript",
		offers: {
			"@type": "Offer",
			price: "0",
			priceCurrency: "USD",
		},
		featureList: [
			"Exact age calculation",
			"Birthday countdown",
			"Hijri calendar conversion",
			"Western zodiac sign calculation",
			"Chinese zodiac calculation",
			"Lifetime statistics",
			"Downloadable age card",
		],
	})}
/>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />

		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		
		<link rel="canonical" href="https://universal-age-calculator.pages.dev/" />

<meta property="og:url" content="https://universal-age-calculator.pages.dev/" />
<meta property="og:image" content="https://universal-age-calculator.pages.dev/og-image.png" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="twitter:image" content="https://universal-age-calculator.pages.dev/og-image.png" />

		<meta name="theme-color" content="#6657ff" />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@graph": [
					{
						"@type": "WebSite",
						"@id": "https://universal-age-calculator.pages.dev/#website",
						url: "https://universal-age-calculator.pages.dev/",
						name: "Universal Age Calculator",
						description: pageDescription,
						inLanguage: "en",
					},
					{
						"@type": "FAQPage",
						"@id": "https://universal-age-calculator.pages.dev/#faq",
						mainEntity: faqItems.map((item) => ({
							"@type": "Question",
							name: item.question,
							acceptedAnswer: {
								"@type": "Answer",
								text: item.answer,
							},
						})),
					},
				],
			})}
		/>

		<script is:inline>
			(function () {
				const savedTheme = localStorage.getItem("age-calculator-theme");
				const prefersDark = window.matchMedia(
					"(prefers-color-scheme: dark)",
				).matches;

				if (savedTheme === "dark" || (!savedTheme && prefersDark)) {
					document.documentElement.dataset.theme = "dark";
				}
			})();
		</script>
	</head>

	<body>
		<header class="site-header">
			<div class="container header-inner">
				<a class="brand" href="/" aria-label="Universal Age Calculator home">
					<span class="brand-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24">
							<path
								d="M12 2.75a1 1 0 0 1 .93.63l1.5 3.76a4 4 0 0 0 2.24 2.24l3.76 1.5a1 1 0 0 1 0 1.86l-3.76 1.5a4 4 0 0 0-2.24 2.24l-1.5 3.76a1 1 0 0 1-1.86 0l-1.5-3.76a4 4 0 0 0-2.24-2.24l-3.76-1.5a1 1 0 0 1 0-1.86l3.76-1.5a4 4 0 0 0 2.24-2.24l1.5-3.76a1 1 0 0 1 .93-.63Z"
