	form .preference-option {
		position: relative;
		display: flex;
		align-items: flex-start;
		gap: 17px;
		width: 100%;
		margin-top: 16px;
		padding: 18px 19px;
		overflow: hidden;
		border: 1px solid rgba(102, 87, 255, 0.14);
		border-radius: 16px;
		background:
			linear-gradient(135deg, rgba(102, 87, 255, 0.055), transparent 62%),
			var(--surface-soft);
		box-shadow:
			0 10px 26px rgba(52, 64, 84, 0.045),
			inset 0 1px 0 rgba(255, 255, 255, 0.58);
		cursor: pointer;
		user-select: none;
		transition:
			transform 180ms ease,
			border-color 180ms ease,
			box-shadow 180ms ease,
			background 180ms ease;
	}

	form .preference-option:hover {
		transform: translateY(-2px);
		border-color: rgba(102, 87, 255, 0.34);
		box-shadow:
			0 16px 34px rgba(52, 64, 84, 0.085),
			0 0 0 4px rgba(102, 87, 255, 0.045);
	}

	form .preference-option:focus-within {
		border-color: rgba(102, 87, 255, 0.66);
		box-shadow:
			0 14px 32px rgba(52, 64, 84, 0.08),
			0 0 0 4px rgba(102, 87, 255, 0.13);
	}

	form .preference-option input {
		position: absolute;
		width: 1px;
		height: 1px;
		min-height: 0;
		padding: 0;
		margin: 0;
		overflow: hidden;
		opacity: 0;
		pointer-events: none;
	}

	.preference-control {
		position: relative;
		z-index: 2;
		display: grid;
		width: 34px;
		height: 34px;
		flex: 0 0 34px;
		place-items: center;
		margin-top: 1px;
		border: 1.5px solid rgba(102, 87, 255, 0.3);
		border-radius: 10px;
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.95), rgba(248, 247, 255, 0.94));
		box-shadow:
			0 6px 15px rgba(52, 64, 84, 0.1),
			inset 0 1px 0 rgba(255, 255, 255, 0.9);
		transition:
			transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1),
			border-color 180ms ease,
			background 180ms ease,
			box-shadow 180ms ease;
	}

	:root[data-theme="dark"] .preference-control {
		background: linear-gradient(180deg, #222838, #1a1f2c);
		box-shadow:
			0 6px 15px rgba(0, 0, 0, 0.18),
			inset 0 1px 0 rgba(255, 255, 255, 0.08);
	}

	.preference-control::after {
		position: absolute;
		inset: 5px;
		content: "";
		border-radius: 6px;
		background: rgba(102, 87, 255, 0.07);
		opacity: 0;
		transform: scale(0.65);
		transition:
			opacity 180ms ease,
			transform 220ms ease;
	}

	.preference-control svg {
		position: relative;
		z-index: 1;
		width: 19px;
		height: 19px;
		fill: none;
		stroke: #ffffff;
		stroke-width: 2.8;
		stroke-linecap: round;
		stroke-linejoin: round;
		opacity: 0;
		transform: scale(0.45) rotate(-10deg);
		transition:
			opacity 150ms ease,
			transform 230ms cubic-bezier(0.2, 0.85, 0.2, 1.2);
	}

	.preference-copy {
		position: relative;
		z-index: 2;
		display: flex;
		min-width: 0;
		flex: 1;
		flex-direction: column;
		gap: 7px;
		padding-top: 1px;
	}

	.preference-copy strong,
	.preference-copy small {
		display: block;
	}

	.preference-copy strong {
		color: var(--text);
		font-size: 0.96rem;
		font-weight: 760;
		line-height: 1.25;
		letter-spacing: -0.018em;
	}

	.preference-copy small {
		max-width: 295px;
		color: var(--text-soft);
		font-size: 0.78rem;
		font-weight: 500;
		line-height: 1.52;
		letter-spacing: -0.005em;
	}

	.preference-glow {
		position: absolute;
		top: -70px;
		left: -55px;
		width: 180px;
		height: 180px;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(102, 87, 255, 0.24), transparent 68%);
		opacity: 0;
		transform: scale(0.72);
		pointer-events: none;
		transition:
			opacity 300ms ease,
			transform 420ms ease;
	}

	form .preference-option:has(input:checked) {
		border-color: rgba(102, 87, 255, 0.48);
		background:
			linear-gradient(135deg, rgba(102, 87, 255, 0.13), rgba(124, 92, 231, 0.045) 72%),
			var(--surface-soft);
		box-shadow:
			0 16px 36px rgba(102, 87, 255, 0.12),
			0 0 0 1px rgba(102, 87, 255, 0.04);
	}

	form .preference-option input:checked + .preference-control {
		border-color: transparent;
		background: linear-gradient(135deg, var(--primary), #7b5bea);
		box-shadow:
			0 9px 20px rgba(102, 87, 255, 0.3),
			0 0 0 5px rgba(102, 87, 255, 0.09);
		transform: scale(1.03);
		animation: preference-check-pop 420ms ease;
	}

	form .preference-option input:checked + .preference-control::after {
		opacity: 1;
		transform: scale(1);
	}

	form .preference-option input:checked + .preference-control svg {
		opacity: 1;
		transform: scale(1) rotate(0);
	}

	form .preference-option:has(input:checked) .preference-glow {
		opacity: 0.72;
		transform: scale(1);
		animation: preference-glow-pulse 700ms ease;
	}

	form .preference-option:has(input:checked) .preference-copy strong {
		color: var(--primary-text);
	}

	@keyframes preference-check-pop {
		0% {
			transform: scale(0.78);
		}

		55% {
			transform: scale(1.1);
		}

		100% {
			transform: scale(1.03);
		}
	}

	@keyframes preference-glow-pulse {
		0% {
			opacity: 0;
			transform: scale(0.55);
		}

		50% {
			opacity: 0.92;
			transform: scale(1.12);
		}

		100% {
