	/* Polished entrance animations */

	.results-section:not([hidden]) .section-heading {
		animation: reveal-up 520ms ease both;
	}

	.results-section:not([hidden]) .age-highlight {
		animation: reveal-up 600ms 80ms ease both;
	}

	.results-section:not([hidden]) .result-card {
		animation: reveal-up 560ms ease both;
	}

	.results-section:not([hidden]) .result-card:nth-child(1) {
		animation-delay: 140ms;
	}

	.results-section:not([hidden]) .result-card:nth-child(2) {
		animation-delay: 200ms;
	}

	.results-section:not([hidden]) .result-card:nth-child(3) {
		animation-delay: 260ms;
	}

	.results-section:not([hidden]) .result-card:nth-child(4) {
		animation-delay: 320ms;
	}

	.results-section:not([hidden]) .world-calendar-panel {
		animation: reveal-up 620ms 220ms ease both;
	}

	.results-section:not([hidden]) .statistics-panel {
		animation: reveal-up 620ms 280ms ease both;
	}

	.results-section:not([hidden]) .fun-statistics-panel {
		animation: reveal-up 620ms 340ms ease both;
	}

	.results-section:not([hidden]) .milestones-panel {
		animation: reveal-up 620ms 400ms ease both;
	}

	.results-section:not([hidden]) .result-actions {
		animation: reveal-up 620ms 460ms ease both;
	}

	.result-card,
	.calendar-card,
	.fun-card,
	.statistic,
	.timeline-item {
		transition:
			transform 180ms ease,
			border-color 180ms ease,
			box-shadow 180ms ease,
			background-color 180ms ease;
	}

	@media (hover: hover) {
		.result-card:hover,
		.calendar-card:hover,
		.fun-card:hover {
			transform: translateY(-4px);
			border-color: rgba(102, 87, 255, 0.24);
			box-shadow: 0 18px 38px rgba(52, 64, 84, 0.11);
		}

		.statistic:hover,
		.timeline-item:hover {
			transform: translateY(-2px);
			background: var(--primary-soft);
		}
	}

	.age-highlight {
		position: relative;
		overflow: hidden;
	}

	.age-highlight::before,
	.age-highlight::after {
		position: absolute;
		content: "";
		border-radius: 50%;
		pointer-events: none;
