---
const pageTitle = "Privacy Policy | Universal Age Calculator";
const pageDescription =
	"Read how Universal Age Calculator handles birth dates, browser storage, technical data and future analytics while keeping calculations private.";

const lastUpdated = "August 8, 2026";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<link
			rel="canonical"
			href="https://universal-age-calculator.pages.dev/privacy"
		/>

		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta
			property="og:url"
			content="https://universal-age-calculator.pages.dev/privacy"
		/>
		<meta
			property="og:image"
			content="https://universal-age-calculator.pages.dev/og-image.png"
		/>

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta
			name="twitter:image"
			content="https://universal-age-calculator.pages.dev/og-image.png"
		/>

		<meta name="theme-color" content="#6657ff" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@type": "WebPage",
				name: "Privacy Policy",
				url: "https://universal-age-calculator.pages.dev/privacy",
				description: pageDescription,
				isPartOf: {
					"@type": "WebSite",
					name: "Universal Age Calculator",
					url: "https://universal-age-calculator.pages.dev/",
				},
				dateModified: "2026-08-08",
				inLanguage: "en",
			})}
		/>

		<script is:inline>
			(function () {
				const savedTheme = localStorage.getItem("age-calculator-theme");
				const prefersDark = window.matchMedia(
					"(prefers-color-scheme: dark)",
				).matches;

				if (savedTheme === "dark" || (!savedTheme && prefersDark)) {
					document.documentElement.dataset.theme = "dark";
				}
			})();
		</script>
	</head>

	<body>
		<header class="site-header">
			<div class="container header-inner">
				<a class="brand" href="/" aria-label="Universal Age Calculator home">
					<span class="brand-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24">
							<path
								d="M12 2.75a1 1 0 0 1 .93.63l1.5 3.76a4 4 0 0 0 2.24 2.24l3.76 1.5a1 1 0 0 1 0 1.86l-3.76 1.5a4 4 0 0 0-2.24 2.24l-1.5 3.76a1 1 0 0 1-1.86 0l-1.5-3.76a4 4 0 0 0-2.24-2.24l-3.76-1.5a1 1 0 0 1 0-1.86l3.76-1.5a4 4 0 0 0 2.24-2.24l1.5-3.76a1 1 0 0 1 .93-.63Z"
							></path>
						</svg>
					</span>

					<span class="brand-copy">
						<strong>Universal</strong>
						<small>Age Calculator</small>
					</span>
				</a>

				<div class="header-actions">
					<a class="header-badge header-link" href="/">Back to calculator</a>

					<button
						id="theme-toggle"
						class="theme-toggle"
						type="button"
						aria-label="Switch to dark mode"
						title="Change colour theme"
					>
						<svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true">
							<circle cx="12" cy="12" r="4"></circle>
							<path d="M12 2v2"></path>
							<path d="M12 20v2"></path>
							<path d="m4.93 4.93 1.42 1.42"></path>
							<path d="m17.66 17.66 1.41 1.41"></path>
							<path d="M2 12h2"></path>
							<path d="M20 12h2"></path>
							<path d="m6.34 17.66-1.41 1.41"></path>
							<path d="m19.07 4.93-1.41 1.41"></path>
						</svg>

						<svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true">
							<path
								d="M20.4 14.6A8.7 8.7 0 0 1 9.4 3.6 8.7 8.7 0 1 0 20.4 14.6Z"
							></path>
						</svg>
					</button>
				</div>
			</div>
		</header>

		<main>
			<section class="policy-hero">
				<div class="hero-orb hero-orb-one" aria-hidden="true"></div>
				<div class="hero-orb hero-orb-two" aria-hidden="true"></div>
				<div class="hero-spark hero-spark-one" aria-hidden="true">✦</div>
				<div class="hero-spark hero-spark-two" aria-hidden="true">✦</div>

				<div class="container policy-hero-inner">
					<div class="policy-hero-copy reveal">
						<div class="hero-kicker">
							<span class="kicker-dot" aria-hidden="true"></span>
							Privacy by design
						</div>

						<h1>Privacy Policy</h1>

						<p class="hero-description">
							Universal Age Calculator is designed so the core calculator can
							work without sending your birth date to a server. This policy
							explains what happens in your browser, what technical data may be
							processed when the site is delivered, and how this policy will
							change if analytics or advertising are introduced later.
						</p>

						<div class="policy-meta">
							<span class="meta-pill">
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path d="M8 2v4"></path>
									<path d="M16 2v4"></path>
									<rect x="3" y="5" width="18" height="16" rx="2"></rect>
									<path d="M3 10h18"></path>
								</svg>
								Last updated: {lastUpdated}
							</span>

							<span class="meta-pill">
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<circle cx="12" cy="12" r="9"></circle>
									<path d="M3 12h18"></path>
									<path d="M12 3c3 3.3 4.3 6.3 4.3 9S15 17.7 12 21"></path>
									<path d="M12 3c-3 3.3-4.3 6.3-4.3 9S9 17.7 12 21"></path>
								</svg>
								universal-age-calculator.pages.dev
							</span>
						</div>
					</div>

					<aside class="privacy-summary reveal" aria-label="Privacy summary">
						<div class="summary-top">
							<div class="summary-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24">
									<rect x="5" y="10" width="14" height="11" rx="2"></rect>
									<path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
								</svg>
							</div>

							<span class="summary-status">
								<span aria-hidden="true"></span>
								Browser-first
							</span>
						</div>

						<p class="summary-label">At a glance</p>
						<h2>Your birth date stays in your browser.</h2>
						<p>
							The calculator does not require an account and does not need
							to upload your selected birth date to calculate your results.
						</p>

						<div class="summary-points">
							<span>
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path d="m5 12 4 4L19 6"></path>
								</svg>
								No account required
							</span>
							<span>
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path d="m5 12 4 4L19 6"></path>
								</svg>
								Core calculations stay local
							</span>
							<span>
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path d="m5 12 4 4L19 6"></path>
								</svg>
								Theme preference only in local storage
							</span>
						</div>
					</aside>
				</div>
			</section>

			<section class="policy-section">
				<div class="container policy-layout">
					<aside class="policy-nav-wrap">
						<nav class="policy-nav" aria-label="Privacy policy navigation">
							<div class="policy-nav-heading">
								<span class="nav-icon" aria-hidden="true">
									<svg viewBox="0 0 24 24">
										<path d="M8 6h13"></path>
										<path d="M8 12h13"></path>
										<path d="M8 18h13"></path>
										<circle cx="3" cy="6" r="1"></circle>
										<circle cx="3" cy="12" r="1"></circle>
										<circle cx="3" cy="18" r="1"></circle>
									</svg>
								</span>
								<div>
									<p>On this page</p>
									<small>11 privacy topics</small>
								</div>
							</div>

							<div class="nav-links">
								<a href="#information-we-process" data-section-link="information-we-process">
									<span>01</span> Information we process
								</a>
								<a href="#birth-date" data-section-link="birth-date">
									<span>02</span> Birth date calculations
								</a>
								<a href="#browser-storage" data-section-link="browser-storage">
									<span>03</span> Browser storage
								</a>
								<a href="#technical-data" data-section-link="technical-data">
									<span>04</span> Technical data
								</a>
								<a href="#cookies" data-section-link="cookies">
									<span>05</span> Cookies
								</a>
								<a href="#analytics" data-section-link="analytics">
									<span>06</span> Analytics & advertising
								</a>
								<a href="#third-parties" data-section-link="third-parties">
									<span>07</span> Third-party services
								</a>
								<a href="#retention" data-section-link="retention">
									<span>08</span> Data retention
								</a>
								<a href="#children" data-section-link="children">
									<span>09</span> Children's privacy
								</a>
								<a href="#choices" data-section-link="choices">
									<span>10</span> Your choices
								</a>
								<a href="#changes" data-section-link="changes">
									<span>11</span> Changes to this policy
								</a>
							</div>

							<div class="nav-privacy-note">
								<div class="nav-note-icon" aria-hidden="true">
									<svg viewBox="0 0 24 24">
										<rect x="5" y="10" width="14" height="11" rx="2"></rect>
										<path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
									</svg>
								</div>
								<p>Core birth-date calculations happen in your browser.</p>
							</div>
						</nav>
					</aside>

					<article class="policy-content">
						<section id="information-we-process" class="policy-block reveal">
							<div class="section-head">
								<span class="section-number">01</span>
								<div class="section-icon" aria-hidden="true">
									<svg viewBox="0 0 24 24">
										<path d="M12 3v18"></path>
										<path d="M3 12h18"></path>
										<circle cx="12" cy="12" r="9"></circle>
									</svg>
								</div>
							</div>

							<h2>Information we process</h2>
							<p>
								The website is built as a browser-based utility. You can use
								the age calculator without creating an account, signing in, or
								providing a name, email address, phone number, or other account
								information.
							</p>
							<p>
								When you enter a birth date, the page uses that value in your
								browser to calculate your exact age, birthday countdown, Hijri
								birth date, Western zodiac sign, Chinese zodiac result, lifetime
								statistics, and downloadable age card.
							</p>

							<div class="policy-callout callout-success">
								<div class="callout-icon" aria-hidden="true">
									<svg viewBox="0 0 24 24">
										<path d="m5 12 4 4L19 6"></path>
									</svg>
								</div>
								<div>
									<strong>Core privacy principle</strong>
									<p>
										The selected birth date is not required to be uploaded to our
										server to produce calculator results.
									</p>
								</div>
							</div>
						</section>

						<section id="birth-date" class="policy-block reveal">
							<div class="section-head">
								<span class="section-number">02</span>
								<div class="section-icon" aria-hidden="true">
									<svg viewBox="0 0 24 24">
										<rect x="3" y="5" width="18" height="16" rx="2"></rect>
										<path d="M16 3v4"></path>
										<path d="M8 3v4"></path>
										<path d="M3 11h18"></path>
									</svg>
								</div>
							</div>

							<h2>Birth date calculations</h2>
							<p>
								The calculator's core calculations are performed with
								JavaScript in your web browser. The birth date you select is
								used temporarily by the page while you are using the calculator.
							</p>
							<p>
								The current version of the site does not provide user accounts
								or a server-side birth-date history. Downloaded age cards are
								created locally in the browser using a canvas and are saved to
								your device only when you choose to download them.
							</p>
							<p>
								The optional “Are you Muslim?” preference changes how certain
								results are presented. That preference is used for the current
								page session and is not intended as an account profile or
								persistent identity record.
							</p>

							<div class="info-strip">
								<div>
									<span>Birth date</span>
									<strong>Used in your browser</strong>
								</div>
								<div>
									<span>Downloaded card</span>
									<strong>Created locally</strong>
								</div>
								<div>
									<span>Display preference</span>
									<strong>Session-based</strong>
								</div>
							</div>
						</section>

						<section id="browser-storage" class="policy-block reveal">
							<div class="section-head">
								<span class="section-number">03</span>
								<div class="section-icon" aria-hidden="true">
									<svg viewBox="0 0 24 24">
										<path d="M4 7h16"></path>
										<path d="M4 12h16"></path>
										<path d="M4 17h16"></path>
										<circle cx="7" cy="7" r="1"></circle>
										<circle cx="7" cy="12" r="1"></circle>
										<circle cx="7" cy="17" r="1"></circle>
									</svg>
								</div>
							</div>

							<h2>Browser storage</h2>
							<p>
								The site currently uses your browser's local storage to remember
								the light or dark appearance preference. This allows the selected
								theme to remain consistent when you return to the site.
							</p>

							<div class="data-table" role="table" aria-label="Browser storage details">
								<div class="data-row data-head" role="row">
									<span role="columnheader">Item</span>
									<span role="columnheader">Purpose</span>
									<span role="columnheader">Stored where</span>
								</div>

								<div class="data-row" role="row">
									<span role="cell"><code>age-calculator-theme</code></span>
									<span role="cell">Remembers light or dark mode</span>
									<span role="cell">Your browser's local storage</span>
								</div>
							</div>

							<p>
								You can remove this preference at any time by clearing site data
								in your browser. Clearing local storage does not affect the
								calculator's ability to work.
							</p>
						</section>

						<section id="technical-data" class="policy-block reveal">
							<div class="section-head">
								<span class="section-number">04</span>
								<div class="section-icon" aria-hidden="true">
									<svg viewBox="0 0 24 24">
										<rect x="3" y="4" width="18" height="16" rx="2"></rect>
										<path d="M7 8h10"></path>
										<path d="M7 12h6"></path>
										<path d="M7 16h8"></path>
									</svg>
								</div>
							</div>

							<h2>Technical data used to deliver the website</h2>
							<p>
								Like most websites, the infrastructure used to serve this site
								may process basic technical information needed to deliver pages
								securely and reliably. This can include information such as an IP
								address, browser type, device information, requested URL, time
								of request, and security-related signals.
							</p>
							<p>
								This site is currently hosted using Cloudflare Pages. Cloudflare
								may process technical request data as part of providing hosting,
								security, performance, and network services. Such processing is
								separate from the calculator's local birth-date calculations.
							</p>

							<div class="policy-callout">
								<div class="callout-icon" aria-hidden="true">
									<svg viewBox="0 0 24 24">
										<circle cx="12" cy="12" r="9"></circle>
										<path d="M12 8v4"></path>
										<path d="M12 16h.01"></path>
									</svg>
								</div>
								<div>
									<strong>Infrastructure vs. calculator data</strong>
									<p>
										Technical request data used to serve and protect the website
										is separate from the birth date used locally for calculations.
									</p>
								</div>
							</div>
						</section>

						<section id="cookies" class="policy-block reveal">
							<div class="section-head">
								<span class="section-number">05</span>
								<div class="section-icon" aria-hidden="true">
									<svg viewBox="0 0 24 24">
										<circle cx="12" cy="12" r="9"></circle>
										<circle cx="9" cy="9" r="1"></circle>
										<circle cx="15" cy="12" r="1"></circle>
										<circle cx="10" cy="16" r="1"></circle>
									</svg>
								</div>
							</div>

							<h2>Cookies</h2>
							<p>
								The current calculator does not require an account cookie to
								perform age calculations. The site's own theme preference uses
								local storage rather than a traditional cookie.
							</p>
							<p>
								Hosting and security providers may use technical mechanisms when
								necessary to protect or deliver the site. If we later add
								analytics, advertising, or other services that use cookies or
								similar technologies, this policy will be updated before those
								services are treated as part of the site's normal operation.
							</p>
						</section>

						<section id="analytics" class="policy-block reveal">
							<div class="section-head">
								<span class="section-number">06</span>
								<div class="section-icon" aria-hidden="true">
									<svg viewBox="0 0 24 24">
										<path d="M4 19V9"></path>
										<path d="M10 19V5"></path>
										<path d="M16 19v-7"></path>
										<path d="M22 19V3"></path>
									</svg>
								</div>
							</div>

							<h2>Analytics and advertising</h2>
							<p>
								At the date shown at the top of this policy, this policy does not
								claim that Google Analytics, Microsoft Clarity, or advertising
								services are active simply because they may be considered for a
								future version of the site.
							</p>
							<p>
								If analytics or advertising is enabled later, we will update
								this page to identify the relevant services, the categories of
								data they process, and any choices available to visitors. Where
								required, an appropriate consent mechanism will also be added.
							</p>

							<div class="future-card">
								<span class="future-status">Future feature</span>
								<strong>No analytics or advertising is being claimed here as active.</strong>
								<p>
									This section explains how the policy will be updated if those
									services are introduced later.
								</p>
							</div>
						</section>

						<section id="third-parties" class="policy-block reveal">
							<div class="section-head">
								<span class="section-number">07</span>
								<div class="section-icon" aria-hidden="true">
									<svg viewBox="0 0 24 24">
										<circle cx="7" cy="12" r="3"></circle>
										<circle cx="17" cy="7" r="3"></circle>
										<circle cx="17" cy="17" r="3"></circle>
										<path d="m9.5 10.5 5-2"></path>
										<path d="m9.5 13.5 5 2"></path>
									</svg>
								</div>
							</div>

							<h2>Third-party services</h2>
							<p>
								The website depends on third-party infrastructure to be available
								on the internet. Cloudflare currently provides hosting and
								content-delivery infrastructure for the live site.
							</p>
							<p>
								Links to external websites, if added in the future, will be
								governed by the privacy practices of those websites. We do not
								control the privacy policies of independent third parties.
							</p>
						</section>

						<section id="retention" class="policy-block reveal">
							<div class="section-head">
								<span class="section-number">08</span>
								<div class="section-icon" aria-hidden="true">
									<svg viewBox="0 0 24 24">
										<path d="M4 7h16"></path>
										<path d="M7 7V4h10v3"></path>
										<path d="M6 7l1 14h10l1-14"></path>
										<path d="M10 11v6"></path>
										<path d="M14 11v6"></path>
									</svg>
								</div>
							</div>

							<h2>Data retention</h2>
							<p>
								Because the core calculator does not require a server-side
								birth-date account or history, we do not maintain a calculator
								database of the birth dates you enter for normal calculations.
							</p>
							<p>
								Technical infrastructure providers may retain network or security
								logs according to their own operational, legal, and security
								requirements. The retention of locally stored theme preferences
								is controlled by your browser and continues until you clear that
								site data or the browser removes it.
							</p>
						</section>

						<section id="children" class="policy-block reveal">
							<div class="section-head">
								<span class="section-number">09</span>
								<div class="section-icon" aria-hidden="true">
									<svg viewBox="0 0 24 24">
										<circle cx="12" cy="8" r="4"></circle>
										<path d="M5 21a7 7 0 0 1 14 0"></path>
									</svg>
								</div>
							</div>

							<h2>Children's privacy</h2>
							<p>
								The calculator is a general-purpose utility and is not designed
								to create profiles of children. It does not require an account or
								a child's name to calculate an age.
							</p>
							<p>
								Parents and guardians should supervise a child's use of online
								services where appropriate. If future features begin collecting
								personal information, this policy will be reviewed before those
								features are introduced.
							</p>
						</section>

						<section id="choices" class="policy-block reveal">
							<div class="section-head">
								<span class="section-number">10</span>
								<div class="section-icon" aria-hidden="true">
									<svg viewBox="0 0 24 24">
										<path d="M4 7h10"></path>
										<path d="M18 7h2"></path>
										<circle cx="16" cy="7" r="2"></circle>
										<path d="M4 17h2"></path>
										<path d="M10 17h10"></path>
										<circle cx="8" cy="17" r="2"></circle>
									</svg>
								</div>
							</div>

							<h2>Your privacy choices</h2>
							<p>
								You can use the calculator without creating an account. You may
								clear the theme preference through your browser's site-data
								settings at any time, and you can choose not to enter a birth
								date if you do not wish to use the calculator.
							</p>
							<p>
								Browser privacy controls, content blockers, and network privacy
								tools may provide additional controls over technical requests to
								web infrastructure.
							</p>

							<div class="choice-grid">
								<div>
									<span>01</span>
									<strong>No account</strong>
									<p>Use the calculator without registering.</p>
								</div>
