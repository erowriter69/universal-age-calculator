	.policy-callout.callout-success {
		border-color: rgba(12, 138, 97, 0.14);
		background:
			linear-gradient(
				135deg,
				rgba(12, 138, 97, 0.06),
				transparent 72%
			),
			var(--surface-soft);
	}

	.callout-icon {
		display: grid;
		width: 36px;
		height: 36px;
		place-items: center;
		border-radius: 11px;
		color: var(--primary);
		background: var(--primary-soft);
