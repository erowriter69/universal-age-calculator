				rgba(102, 87, 255, 0.035),
				transparent 24%
			),
			var(--surface-raised);
	}

	.footer-glow {
		position: absolute;
		border-radius: 50%;
		filter: blur(12px);
		pointer-events: none;
	}

	.footer-glow-one {
		top: -220px;
		left: -180px;
		width: 440px;
		height: 440px;
		background: rgba(102, 87, 255, 0.08);
	}

	.footer-glow-two {
		right: -150px;
		bottom: -250px;
		width: 420px;
		height: 420px;
		background: rgba(124, 92, 231, 0.075);
	}

	.footer-shell {
		position: relative;
		z-index: 1;
	}

	.footer-main {
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(190px, 0.65fr) minmax(260px, 0.9fr);
		gap: clamp(38px, 6vw, 82px);
		padding-bottom: 48px;
