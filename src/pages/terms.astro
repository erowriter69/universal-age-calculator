		color: var(--text);
		font-size: 0.67rem;
		font-weight: 900;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	code {
		padding: 4px 7px;
		border-radius: 7px;
		color: var(--primary-text);
		background: var(--primary-soft);
		font-size: 0.71rem;
		font-weight: 750;
	}

	.future-card {
		position: relative;
		margin-top: 23px;
		padding: 19px 20px;
