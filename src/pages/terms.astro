		box-shadow: 0 16px 34px rgba(102, 87, 255, 0.3);
	}

	.policy-end-card > a svg {
		width: 15px;
		height: 15px;
	}

	.site-footer {
		position: relative;
		padding: 72px 0 26px;
		overflow: hidden;
		border-top: 1px solid rgba(102, 87, 255, 0.15);
		background:
			linear-gradient(
