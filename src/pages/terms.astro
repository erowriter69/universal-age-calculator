		box-shadow: 0 10px 24px rgba(102, 87, 255, 0.09);
	}

	.footer-brand-icon svg {
		width: 23px;
		height: 23px;
		fill: var(--primary);
		stroke: none;
	}

	.footer-brand-copy {
		display: grid;
		gap: 1px;
	}

	.footer-brand-copy strong {
		font-size: 1rem;
		font-weight: 900;
		letter-spacing: -0.025em;
	}

	.footer-brand-copy small {
		color: var(--text-faint);
		font-size: 0.72rem;
		font-weight: 750;
		letter-spacing: 0.065em;
		text-transform: uppercase;
	}

	.footer-description {
		max-width: 480px;
		margin: 22px 0 24px;
		color: var(--text-soft);
		font-size: 0.92rem;
		line-height: 1.75;
	}

