									<path d="M8 2v4"></path>
									<path d="M16 2v4"></path>
									<rect x="3" y="5" width="18" height="16" rx="2"></rect>
									<path d="M3 10h18"></path>
								</svg>
								Last updated: {lastUpdated}
							</span>

							<span class="meta-pill">
								<svg viewBox="0 0 24 24" aria-hidden="true">
