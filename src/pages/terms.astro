	.choice-grid > div {
		padding: 16px;
		border: 1px solid var(--border);
		border-radius: 15px;
		background: var(--surface);
	}

	.choice-grid span {
		display: grid;
		width: 29px;
		height: 29px;
		place-items: center;
		margin-bottom: 12px;
		border-radius: 9px;
		color: var(--primary-text);
		background: var(--primary-soft);
		font-size: 0.61rem;
		font-weight: 900;
	}

	.choice-grid strong {
		display: block;
		margin-bottom: 5px;
