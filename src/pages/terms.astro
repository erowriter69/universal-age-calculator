		display: grid;
		width: 44px;
		height: 44px;
		place-items: center;
		border: 1px solid rgba(102, 87, 255, 0.2);
		border-radius: 14px;
		background: linear-gradient(
			135deg,
			rgba(102, 87, 255, 0.14),
			rgba(124, 92, 231, 0.06)
