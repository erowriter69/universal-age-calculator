	.footer-bottom-links a[aria-current="page"] {
		color: var(--primary-text);
	}

	.footer-bottom-note {
		flex: 0 0 auto;
	}

	.reveal {
		opacity: 0;
		transform: translateY(18px);
		transition:
			opacity 560ms ease,
			transform 560ms ease;
	}

	.reveal.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	@media (hover: hover) {
		.nav-links a:hover {
			transform: translateX(2px);
		}

		.info-strip > div,
		.choice-grid > div,
		.future-card,
		.data-table {
			transition:
				transform 180ms ease,
				border-color 180ms ease,
				box-shadow 180ms ease;
		}

		.info-strip > div:hover,
		.choice-grid > div:hover {
			background: var(--primary-soft);
		}

		.choice-grid > div:hover,
		.future-card:hover,
		.data-table:hover {
			transform: translateY(-2px);
			border-color: rgba(102, 87, 255, 0.2);
			box-shadow: 0 16px 34px rgba(52, 64, 84, 0.07);
		}

		.footer-navigation a:hover {
			color: var(--primary-text);
			border-color: rgba(102, 87, 255, 0.12);
			transform: translateX(3px);
		}

		.footer-navigation a:hover svg {
			color: var(--primary);
			opacity: 1;
