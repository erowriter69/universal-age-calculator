		display: flex;
		flex-wrap: wrap;
		gap: 9px;
	}

	.footer-trust span {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		padding: 8px 11px;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--surface-soft);
		color: var(--text-soft);
		font-size: 0.72rem;
		font-weight: 750;
	}

	.footer-trust svg {
		width: 14px;
		height: 14px;
		color: var(--success);
		stroke-width: 2.5;
	}

	.footer-heading {
		margin: 4px 0 18px;
		color: var(--text);
		font-size: 0.76rem;
		font-weight: 900;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.footer-navigation {
		display: flex;
		flex-direction: column;
		align-items: stretch;
	}

	.footer-navigation a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 18px;
		padding: 9px 0;
		border-bottom: 1px solid transparent;
		color: var(--text-soft);
		font-size: 0.84rem;
		font-weight: 700;
		text-decoration: none;
		transition:
			color 180ms ease,
			transform 180ms ease,
			border-color 180ms ease;
	}

	.footer-navigation a svg {
		width: 15px;
		height: 15px;
		flex: 0 0 auto;
		color: var(--text-faint);
		opacity: 0;
		transform: translateX(-5px);
		transition:
			opacity 180ms ease,
			transform 180ms ease,
			color 180ms ease;
	}

	.footer-privacy-card {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 14px;
		padding: 18px;
		border: 1px solid rgba(102, 87, 255, 0.14);
		border-radius: 18px;
		background:
			linear-gradient(
				135deg,
				rgba(102, 87, 255, 0.07),
				transparent 70%
			),
			var(--surface-soft);
		box-shadow: 0 14px 34px rgba(52, 64, 84, 0.045);
	}

	.footer-privacy-icon {
		display: grid;
		width: 36px;
		height: 36px;
		place-items: center;
		border-radius: 11px;
		color: var(--primary);
		background: rgba(102, 87, 255, 0.1);
	}

	.footer-privacy-icon svg {
		width: 18px;
		height: 18px;
	}

	.footer-privacy-card strong {
		display: block;
		margin-bottom: 6px;
		color: var(--text);
		font-size: 0.84rem;
		line-height: 1.4;
	}

	.footer-privacy-card p {
		margin: 0;
		color: var(--text-faint);
		font-size: 0.75rem;
		line-height: 1.65;
	}

	.footer-back-link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin-top: 18px;
		color: var(--primary-text);
		font-size: 0.78rem;
		font-weight: 850;
		text-decoration: none;
		transition:
			color 180ms ease,
			transform 180ms ease;
	}

	.footer-back-link svg {
		width: 15px;
		height: 15px;
	}

	.footer-bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		padding-top: 22px;
		border-top: 1px solid var(--border);
	}

	.footer-bottom p {
		margin: 0;
		color: var(--text-faint);
		font-size: 0.72rem;
		line-height: 1.6;
	}

	.footer-bottom-links {
		display: flex;
		align-items: center;
		gap: 9px;
		flex: 0 0 auto;
	}

	.footer-bottom-links > span {
		color: var(--text-faint);
		font-size: 0.68rem;
	}

	.footer-bottom-links a {
		color: var(--text-faint);
		font-size: 0.72rem;
		font-weight: 750;
		text-decoration: none;
		transition: color 180ms ease;
