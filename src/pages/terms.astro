---
const pageTitle = "Terms of Use | Universal Age Calculator";
const pageDescription =
	"Read the Terms of Use for Universal Age Calculator, including calculator limitations, calendar and zodiac information, acceptable use and downloadable results.";

const lastUpdated = "August 8, 2026";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<link
			rel="canonical"
			href="https://universal-age-calculator.pages.dev/terms"
		/>

		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta
			property="og:url"
			content="https://universal-age-calculator.pages.dev/terms"
		/>
		<meta
			property="og:image"
			content="https://universal-age-calculator.pages.dev/og-image.png"
		/>

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta
			name="twitter:image"
			content="https://universal-age-calculator.pages.dev/og-image.png"
		/>

		<meta name="theme-color" content="#6657ff" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@type": "WebPage",
				name: "Terms of Use",
				url: "https://universal-age-calculator.pages.dev/terms",
				description: pageDescription,
				isPartOf: {
					"@type": "WebSite",
					name: "Universal Age Calculator",
					url: "https://universal-age-calculator.pages.dev/",
				},
				dateModified: "2026-08-08",
				inLanguage: "en",
			})}
		/>

		<script is:inline>
			(function () {
				const savedTheme = localStorage.getItem("age-calculator-theme");
				const prefersDark = window.matchMedia(
					"(prefers-color-scheme: dark)",
				).matches;

				if (savedTheme === "dark" || (!savedTheme && prefersDark)) {
					document.documentElement.dataset.theme = "dark";
				}
			})();
		</script>
	</head>

	<body>
		<header class="site-header">
			<div class="container header-inner">
				<a class="brand" href="/" aria-label="Universal Age Calculator home">
					<span class="brand-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24">
							<path
								d="M12 2.75a1 1 0 0 1 .93.63l1.5 3.76a4 4 0 0 0 2.24 2.24l3.76 1.5a1 1 0 0 1 0 1.86l-3.76 1.5a4 4 0 0 0-2.24 2.24l-1.5 3.76a1 1 0 0 1-1.86 0l-1.5-3.76a4 4 0 0 0-2.24-2.24l-3.76-1.5a1 1 0 0 1 0-1.86l3.76-1.5a4 4 0 0 0 2.24-2.24l1.5-3.76a1 1 0 0 1 .93-.63Z"
							></path>
						</svg>
					</span>

					<span class="brand-copy">
						<strong>Universal</strong>
						<small>Age Calculator</small>
					</span>
				</a>

				<div class="header-actions">
					<a class="header-badge header-link" href="/">Back to calculator</a>

					<button
						id="theme-toggle"
						class="theme-toggle"
						type="button"
						aria-label="Switch to dark mode"
						title="Change colour theme"
					>
						<svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true">
							<circle cx="12" cy="12" r="4"></circle>
