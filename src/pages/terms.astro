	.policy-callout {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 13px;
		margin-top: 24px;
		padding: 18px;
		border: 1px solid rgba(102, 87, 255, 0.14);
		border-radius: 17px;
		background:
			linear-gradient(
