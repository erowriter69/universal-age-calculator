								<a href="#estimates" data-section-link="estimates"><span>05</span> Lifetime estimates</a>
								<a href="#downloads" data-section-link="downloads"><span>06</span> Downloaded cards</a>
								<a href="#acceptable-use" data-section-link="acceptable-use"><span>07</span> Acceptable use</a>
								<a href="#availability" data-section-link="availability"><span>08</span> Availability</a>
								<a href="#third-parties" data-section-link="third-parties"><span>09</span> Third-party services</a>
								<a href="#warranties" data-section-link="warranties"><span>10</span> No warranties</a>
								<a href="#liability" data-section-link="liability"><span>11</span> Limitation of liability</a>
								<a href="#changes" data-section-link="changes"><span>12</span> Changes to these terms</a>
							</div>

							<div class="nav-privacy-note terms-nav-note">
