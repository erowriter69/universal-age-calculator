	.nav-privacy-note {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 9px;
		padding: 12px;
		border: 1px solid rgba(12, 138, 97, 0.12);
		border-radius: 13px;
		background: var(--success-soft);
	}

	.nav-note-icon {
		display: grid;
		width: 28px;
		height: 28px;
		place-items: center;
		border-radius: 9px;
		color: var(--success);
		background: var(--surface);
	}

	.nav-note-icon svg {
		width: 14px;
		height: 14px;
	}

	.nav-privacy-note p {
		margin: 0;
		color: var(--success);
		font-size: 0.66rem;
		font-weight: 750;
		line-height: 1.5;
	}

	.policy-content {
		min-width: 0;
	}

	.policy-block {
		position: relative;
		padding: 0 0 48px;
		margin-bottom: 48px;
		border-bottom: 1px solid var(--border);
